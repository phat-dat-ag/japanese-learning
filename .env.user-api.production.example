# Separate Linux release signing input; provision independent production keys.
# Container env_file; paths refer to read-only container mounts.
# Keep local files untracked. Publish matching key IDs in both services.
# Exactly one signing key must be active; RSA keys must be at least 2048 bits.

# Runtime (Dockerfile defaults; Development enables local Swagger)
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
Http__RedirectToHttps=false

# Key 0
APP_SECURITY_SIGNING_KEYS_0_KID=jp-user-1
APP_SECURITY_SIGNING_KEYS_0_PRIVATE_KEY_PATH=/run/keys/jwt/user-privatekey-1.pem
APP_SECURITY_SIGNING_KEYS_0_ACTIVE=false

# Key 1
APP_SECURITY_SIGNING_KEYS_1_KID=jp-user-2
APP_SECURITY_SIGNING_KEYS_1_PRIVATE_KEY_PATH=/run/keys/jwt/user-privatekey-2.pem
APP_SECURITY_SIGNING_KEYS_1_ACTIVE=true

# Key 2
APP_SECURITY_SIGNING_KEYS_2_KID=jp-user-3
APP_SECURITY_SIGNING_KEYS_2_PRIVATE_KEY_PATH=/run/keys/jwt/user-privatekey-3.pem
APP_SECURITY_SIGNING_KEYS_2_ACTIVE=false

# Runtime options; root Compose overrides database, JWT and tracing.
Database__Server=localhost,1433
Database__Name=JapaneseLearningUser
Database__User=sa
Database__Password=
Database__TrustServerCertificate=true
# Must remain empty with Compose's split Database__ fields.
Database__ConnectionString=
Jwt__Issuer=JapaneseLearning.User
Jwt__Audience=JapaneseLearning
Jwt__JwksUrl=http://localhost:8083/api/v1/jwks/user
Jwt__RequireHttpsMetadata=false
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7
Logging__SlowRequestThresholdMilliseconds=1000
LogFiles__Directory=logs
LogFiles__RetentionDays=30
LogFiles__FileSizeLimitBytes=104857600
LogFiles__RetainedFileCountLimit=300
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__JapaneseLearning.User=Information
Serilog__MinimumLevel__Override__Microsoft.Hosting.Lifetime=Information
AllowedHosts=*
Tracing__ExportEnabled=false
Tracing__SampleRatio=0.1
Tracing__MaxRootsPerSecond=10
Tracing__Environment=development
Tracing__Endpoint=http://localhost:4317
Observability__ServiceVersion=unknown
Serilog__MinimumLevel__Override__Microsoft=Warning
Serilog__MinimumLevel__Override__System=Warning

# Host selection is independent of the telemetry environment label.
DOTNET_ENVIRONMENT=Production
