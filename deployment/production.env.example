# Copy to .env.production; restrict permissions and fill required values.
# Use an immutable RELEASE_TAG and a licensed MSSQL_PID (Express or Standard).
# Provision signing/public key files separately; never commit filled env files.

# Release (production overlay only)
RELEASE_TAG=
MSSQL_PID=

# MySQL (required; shared with Flyway and vocabulary-api)
MYSQL_DATABASE=japanese_learning
MYSQL_USER=japanese_learning
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# SQL Server (database and password required)
MSSQL_DATABASE=JapaneseLearningUser
MSSQL_SA_PASSWORD=
MSSQL_MEMORY_LIMIT_MB=2048

# JWT (issuer and audience required; shared by both APIs)
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Verification (HTTP stays inside the Docker network)
JWKS_API_INTERNAL_URL=http://jwks-api:8080
JWT_JWKS_URL=http://jwks-api:8080/.well-known/jwks.json
JWT_JWKS_REQUIRE_HTTPS=false
AUTH_JWKS_CACHE_TTL=10M

# User API signing (container key paths live in the service env file)
USER_API_SIGNING_ENV_FILE=./.env.user-api.production
USER_API_SIGNING_KEYS_HOST_PATH=./secrets/private/user-api

# JWKS API (public keys only)
JWKS_API_ENV_FILE=./.env.jwks-api
JWKS_API_PUBLIC_KEYS_HOST_PATH=./secrets/public
JWKS_API_SPRING_PROFILES_ACTIVE=default
JWKS_API_LOG_LEVEL=INFO

# Vocabulary API timing (optional Compose defaults)
VOCABULARY_API_OIDC_CONNECTION_DELAY=60S
VOCABULARY_API_SHUTDOWN_TIMEOUT=20S

# Migration mounts (repository-relative)
QUARKUS_MIGRATION_PATH=./quarkus/src/main/resources/db/migration
DOTNET_MIGRATION_PATH=./dotnet/db/migration

# Loopback host ports (production removes all except frontend and Grafana)
MYSQL_HOST_PORT=3306
MSSQL_HOST_PORT=1433
JWKS_API_HOST_PORT=8083
USER_API_HOST_PORT=8081
VOCABULARY_API_HOST_PORT=8082
GATEWAY_HOST_PORT=8080
FRONTEND_PORT=8088

# Optional monitoring (password required only when enabled)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_HOST_PORT=3000
GRAFANA_LOG_LEVEL=warn
PROMETHEUS_HOST_PORT=9090
PROMETHEUS_RETENTION_TIME=2d
PROMETHEUS_RETENTION_SIZE=512MB
