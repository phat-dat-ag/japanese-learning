# Copy to .env.production and chmod 600. Never commit the filled file.
# All secrets are blank placeholders. Prefer generated random hex passwords.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MSSQL_SA_PASSWORD=
MYSQL_DATABASE=japanese_learning
MYSQL_USER=japanese_learning
# Required: licensed production edition, e.g. Express or Standard; never Developer.
MSSQL_PID=
# Required immutable image tag, e.g. a release ID + root commit (never reuse).
RELEASE_TAG=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_KEY_ID=
# Optional indexed signing list, kept separate from development configuration.
# Copy .env.user-api.example, then configure this environment's actual keys/kids.
USER_API_SIGNING_ENV_FILE=./.env.user-api.production
USER_API_SIGNING_KEYS_HOST_PATH=./secrets/jwt
# Verification uses the independent service on the internal api network.
JWKS_API_INTERNAL_URL=http://jwks-api:8080
JWT_JWKS_URL=http://jwks-api:8080/.well-known/jwks.json
JWT_JWKS_REQUIRE_HTTPS=false
AUTH_JWKS_CACHE_TTL=10M
# Public-only host directory; configure matching kid(s) in .env.jwks-api separately.
JWKS_API_PUBLIC_KEYS_HOST_PATH=./secrets/jwks
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
FRONTEND_PORT=8088
# Optional monitoring only.
GRAFANA_ADMIN_PASSWORD=
# Paths stay repository-relative; keys are read-only binds from secrets/jwt/.
QUARKUS_MIGRATION_PATH=./quarkus/src/main/resources/db/migration
DOTNET_MIGRATION_PATH=./dotnet/db/migration
