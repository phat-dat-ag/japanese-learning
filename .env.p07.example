# Development only. Run node scripts/setup-p07-security.cjs once.
# Generated values are in Git-ignored secrets/p07/*.env; never paste real secrets here.
# Existing directory for disk metrics; use the Docker backing drive if different.
DOCKER_DATA_HOST_PATH=D:/DockerData/DockerDesktopWSL/disk
P07_WRITER_PASSWORD=
P07_DASHBOARDS_PASSWORD=
P07_ADMIN_PASSWORD=
P07_MONITOR_TOKEN=
