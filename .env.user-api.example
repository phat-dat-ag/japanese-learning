# Container env_file; paths refer to read-only container mounts.
# Keep local files untracked. Publish matching key IDs in both services.
# Exactly one signing key must be active; RSA keys must be at least 2048 bits.

# Runtime (Dockerfile defaults; Development enables local Swagger)
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
Http__RedirectToHttps=false

# Key 0
APP_SECURITY_SIGNING_KEYS_0_KID=jp-user-1
APP_SECURITY_SIGNING_KEYS_0_PRIVATE_KEY_PATH=/run/keys/jwt/user-privatekey-1.pem
APP_SECURITY_SIGNING_KEYS_0_ACTIVE=false

# Key 1
APP_SECURITY_SIGNING_KEYS_1_KID=jp-user-2
APP_SECURITY_SIGNING_KEYS_1_PRIVATE_KEY_PATH=/run/keys/jwt/user-privatekey-2.pem
APP_SECURITY_SIGNING_KEYS_1_ACTIVE=true

# Key 2
APP_SECURITY_SIGNING_KEYS_2_KID=jp-user-3
APP_SECURITY_SIGNING_KEYS_2_PRIVATE_KEY_PATH=/run/keys/jwt/user-privatekey-3.pem
APP_SECURITY_SIGNING_KEYS_2_ACTIVE=false
