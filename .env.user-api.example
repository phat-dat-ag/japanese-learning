# user-api signing keys only; loaded by Compose env_file.
# Copy to .env.user-api. Keep the local file untracked.
# Paths below are CONTAINER paths under /run/keys/jwt.
# USER_API_SIGNING_KEYS_HOST_PATH selects the HOST directory containing these files.
# Exactly one configured key must be active; every private key must be readable RSA >=2048 bits.
# The active kid and corresponding public key MUST also be published by Spring JWKS.
# No private keys belong in Spring JWKS or Quarkus.

# Development: use this project's existing private key without generating/replacing it.
APP_SECURITY_SIGNING_KEYS_0_KID=japanese-learning-local-1
APP_SECURITY_SIGNING_KEYS_0_PRIVATE_KEY_PATH=/run/keys/jwt/private.pem
APP_SECURITY_SIGNING_KEYS_0_ACTIVE=true

# Rotation: obtain the additional signing key through your key provisioning process.
# Add its public key to Spring JWKS before activating it here. Use contiguous indices.
# APP_SECURITY_SIGNING_KEYS_1_KID=japanese-learning-local-2
# APP_SECURITY_SIGNING_KEYS_1_PRIVATE_KEY_PATH=/run/keys/jwt/private-v2.pem
# APP_SECURITY_SIGNING_KEYS_1_ACTIVE=false

# When any indexed entry is present, this list replaces legacy Jwt__PrivateKeyPath /
# Jwt__PublicKeyPath / Jwt__KeyId for signing. Recreate user-api after changes.
