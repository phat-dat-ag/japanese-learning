# Copy to .env. Blank password placeholders MUST be set locally.
# Never commit .env or RSA keys; other values below are non-sensitive defaults.
# Sensitive values: placeholders only.
# Single-quote values containing $ to prevent Compose interpolation.
# MySQL image initializer: no quotes, backslashes or control characters in passwords.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# At least 8 characters; use three of uppercase, lowercase, digits, and symbols.
MSSQL_SA_PASSWORD=

# Non-sensitive database configuration.
MYSQL_DATABASE=japanese_learning
MYSQL_USER=japanese_learning

# Existing migration directories, relative to this root repository.
QUARKUS_MIGRATION_PATH=./quarkus/src/main/resources/db/migration
DOTNET_MIGRATION_PATH=./dotnet/db/migration

# Shared token contract: mapped to .NET Jwt__* and Quarkus AUTH_JWT_*.
JWT_ISSUER=JapaneseLearning.User
JWT_AUDIENCE=JapaneseLearning
JWT_KEY_ID=japanese-learning-local-1
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15

# Required local files (never supplied as environment values or image inputs):
# ./secrets/jwt/private.pem
# ./secrets/jwt/public.pem
# Generate with: pwsh -File ./scripts/generate-jwt-keys.ps1

# Optional compose.observability.yml only: supply a strong local Grafana admin password.
GRAFANA_ADMIN_PASSWORD=
