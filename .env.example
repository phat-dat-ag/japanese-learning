# ============================================================
# MySQL
# ============================================================

# MySQL database name used by the application
MYSQL_DATABASE=japanese_learning

# MySQL root password
MYSQL_ROOT_PASSWORD=change-me

# MySQL application user
MYSQL_USER=japanese_learning

# MySQL application user password
MYSQL_PASSWORD=change-me


# ============================================================
# SQL Server
# ============================================================

# SQL Server system administrator password
# Must satisfy SQL Server password complexity requirements
MSSQL_SA_PASSWORD=change-me


# ============================================================
# Database Migration Paths
# ============================================================

# Quarkus Flyway migration directory
# Path is relative to the project root where docker-compose.yml is located
QUARKUS_MIGRATION_PATH=./quarkus/src/main/resources/db/migration

# .NET database migration directory
# Path is relative to the project root where docker-compose.yml is located
DOTNET_MIGRATION_PATH=./dotnet/db/migration