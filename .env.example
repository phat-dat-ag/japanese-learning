# MySQL - Used by MySQL, Flyway Vocabulary, and Quarkus Vocabulary API

MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=japanese_learning
MYSQL_USER=backend

# SQL Server - Used by SQL Server, SQL Server Init, Flyway User, and .NET User API

MSSQL_DATABASE=JapaneseLearningUser
MSSQL_SA_PASSWORD=

# SQL Server Edition - Used by SQL Server container
# Example: Express or Standard. Do not use Developer for production.

MSSQL_PID=Express

# Release - Used to identify the application image version
# Use an immutable release tag, e.g. a release ID + root commit. Never reuse a release tag.

RELEASE_TAG=2026.09.24-1

# JWT - Shared by .NET User API and Quarkus Vocabulary API

JWT_ISSUER=JapaneseLearning.User
JWT_AUDIENCE=JapaneseLearning

# Required signing config; copy .env.user-api.example to this local file.
USER_API_SIGNING_ENV_FILE=./.env.user-api
USER_API_SIGNING_KEYS_HOST_PATH=./secrets/private/user-api

# Shared verification endpoint inside Docker; .NET remains the issuer.
JWKS_API_INTERNAL_URL=http://jwks-api:8080
JWT_JWKS_URL=http://jwks-api:8080/.well-known/jwks.json

# HTTP is restricted to the trusted Docker network. Use true for external HTTPS JWKS.
JWT_JWKS_REQUIRE_HTTPS=false
AUTH_JWKS_CACHE_TTL=10M
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Frontend - Used by Angular Frontend container

FRONTEND_PORT=8088

# Monitoring - Used by Grafana
# Optional. Set a secure Grafana admin password when monitoring is enabled.

GRAFANA_ADMIN_PASSWORD=

# Flyway Migration Paths - Used by Flyway Vocabulary and Flyway User

QUARKUS_MIGRATION_PATH=./quarkus/src/main/resources/db/migration
DOTNET_MIGRATION_PATH=./dotnet/db/migration

# =========================
# Host Ports - Development
# =========================
# Host ports exposed by Docker Compose for local development.
# These values can be overridden by environment-specific .env files
# when running multiple Compose projects at the same time.
#
# Format:
# HOST_PORT -> CONTAINER_PORT
#
# MySQL:          localhost:3306
# SQL Server:     localhost:1433
# User API:       localhost:8081
# Vocabulary API: localhost:8082
# API Gateway:    localhost:8080
# Frontend:       localhost:8088

MYSQL_HOST_PORT=3306
JWKS_API_HOST_PORT=8083

# Host directory containing PUBLIC keys only (never include private keys).
JWKS_API_PUBLIC_KEYS_HOST_PATH=./secrets/public
JWKS_API_SPRING_PROFILES_ACTIVE=default
JWKS_API_LOG_LEVEL=INFO

# Copy .env.jwks-api.example to .env.jwks-api for container key configuration.
MSSQL_HOST_PORT=1433
USER_API_HOST_PORT=8081
VOCABULARY_API_HOST_PORT=8082
GATEWAY_HOST_PORT=8080
FRONTEND_PORT=8088
