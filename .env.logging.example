# Viewer credentials reference; not Compose inputs.
# Generate .env.logging and its matching bcrypt file with:
# python -B scripts/setup-log-access.py
# Do not copy this file before setup; the script refuses existing credentials.

LOGS_UI_USERNAME=logs-admin
LOGS_UI_PASSWORD=

# Editing .env.logging does not change the login; NGINX reads the bcrypt file.
# Operational logging settings are documented in the root .env.example.
