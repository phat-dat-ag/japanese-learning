# Partial override: load after a complete Compose env file using a second --env-file.

# MySQL
MYSQL_DATABASE=jp_vocabulary_prod
MYSQL_USER=backend
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# SQL Server
MSSQL_DATABASE=jp_user_prod
MSSQL_SA_PASSWORD=

# Loopback host ports for compose.local-production.yml
MYSQL_HOST_PORT=1806
MSSQL_HOST_PORT=1833
USER_API_HOST_PORT=1881
VOCABULARY_API_HOST_PORT=1882
GATEWAY_HOST_PORT=1880
FRONTEND_PORT=1888

# Local project isolation; never reuse the DEV project name.
COMPOSE_PROJECT_NAME=jp_learning_prod
JWKS_API_HOST_PORT=1883
PROMETHEUS_HOST_PORT=19091
GRAFANA_HOST_PORT=13001
MONITORING_PROMETHEUS_HOST_PORT=19091
MONITORING_GRAFANA_HOST_PORT=13001
LOGS_UI_PORT=15601
LOG_ENVIRONMENT=production
JP_TRACE_EXPORT_ENABLED=false
JP_TRACE_SAMPLE_RATIO=0.01
JP_TRACE_MAX_ROOTS_PER_SECOND=10
MSSQL_PID=Express
# Secrets above must be supplied; blank overrides intentionally block startup.
# Existing signing/JWKS files are shared read-only, without rotation.
# Internal URLs keep service DNS names and resolve within this project.
