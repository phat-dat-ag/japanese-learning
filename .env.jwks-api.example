# Container environment, loaded by Compose env_file (not a Compose --env-file).
# Copy to .env.jwks-api. Paths below are CONTAINER paths, not host paths.
# Files are supplied by JWKS_API_PUBLIC_KEYS_HOST_PATH in the root .env.
APP_SECURITY_JWKS_KEYS_0_KID=japanese-learning-local-1
APP_SECURITY_JWKS_KEYS_0_PUBLIC_KEY_PATH=/run/keys/jwks/user-api-public.pem

# Rotation: contiguous indices and unique IDs; all configured public keys are published.
# All configured entries are published. Restart after key changes.
# APP_SECURITY_JWKS_KEYS_1_KID=japanese-learning-local-2
# APP_SECURITY_JWKS_KEYS_1_PUBLIC_KEY_PATH=/run/keys/jwks/user-api-public-v2.pem

# Optional application settings (application defaults apply when omitted):
# SPRING_APPLICATION_NAME=jwks-service
# APP_NAME=jwks-api
# LOGGING_LEVEL_COM_JAPANESELEARNING_JWKS=INFO
# SERVER_FORWARD_HEADERS_STRATEGY=none
