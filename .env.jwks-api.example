# Container env_file; paths refer to read-only container mounts.
# Keep local files untracked. Publish matching key IDs in both services.
# Public keys only. All configured entries are published.

# Key 0
APP_SECURITY_JWKS_KEYS_0_KID=jp-user-1
APP_SECURITY_JWKS_KEYS_0_PUBLICKEYPATH=/run/keys/jwks/user-publickey-1.pem

# Key 1
APP_SECURITY_JWKS_KEYS_1_KID=jp-user-2
APP_SECURITY_JWKS_KEYS_1_PUBLICKEYPATH=/run/keys/jwks/user-publickey-2.pem

# Key 2
APP_SECURITY_JWKS_KEYS_2_KID=jp-user-3
APP_SECURITY_JWKS_KEYS_2_PUBLICKEYPATH=/run/keys/jwks/user-publickey-3.pem

# Learning is unused; configure only User ownership.
APP_SECURITY_JWKS_KEYS_0_OWNER=USER
APP_SECURITY_JWKS_KEYS_1_OWNER=USER
APP_SECURITY_JWKS_KEYS_2_OWNER=USER
