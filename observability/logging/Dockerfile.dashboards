FROM opensearchproject/opensearch-dashboards:3.9.0@sha256:256d4cea5928868ac09bca642a0ac8285a2b7e4b7fdd45c4ec06e75a5cf3184c
# Authentication belongs to the private, loopback-only NGINX ingress.
RUN /usr/share/opensearch-dashboards/bin/opensearch-dashboards-plugin remove securityDashboards
COPY opensearch-dashboards.yml /usr/share/opensearch-dashboards/config/opensearch_dashboards.yml
ENTRYPOINT ["/usr/share/opensearch-dashboards/bin/opensearch-dashboards"]
