  "recording_rules": [
    {
      "record": "jp_p05:http_requests:rate5m",
      "expr": "sum by (job) (rate(http_requests_received_total{job=\"user-api\"}[5m])) or sum by (job) (rate(http_server_requests_seconds_count{job=\"vocabulary-api\"}[5m]))"
    },
    {
      "record": "jp_p05:http_5xx:rate5m",
      "expr": "sum by (job) (rate(http_requests_received_total{job=\"user-api\",code=~\"5..\"}[5m])) or sum by (job) (rate(http_server_requests_seconds_count{job=\"vocabulary-api\",status=~\"5..\"}[5m]))"
    },
    {
      "record": "jp_p05:http_5xx:increase5m",
      "expr": "sum by (job) (increase(http_requests_received_total{job=\"user-api\",code=~\"5..\"}[5m])) or sum by (job) (increase(http_server_requests_seconds_count{job=\"vocabulary-api\",status=~\"5..\"}[5m]))"
    },
    {
      "record": "jp_p05:http_requests:increase5m",
      "expr": "sum by (job) (increase(http_requests_received_total{job=\"user-api\"}[5m])) or sum by (job) (increase(http_server_requests_seconds_count{job=\"vocabulary-api\"}[5m]))"
    },
    {
      "record": "jp_p05:http_duration:rate5m",
      "expr": "sum by (job) (rate(http_request_duration_seconds_count{job=\"user-api\",route!=\"import\"}[5m])) or sum by (job) (rate(http_server_requests_seconds_count{job=\"vocabulary-api\",route!=\"import\"}[5m]))"
    },
    {
      "record": "jp_p05:http_fast2s:rate5m",
      "expr": "sum by (job) (rate(http_request_duration_seconds_bucket{job=\"user-api\",route!=\"import\",le=~\"2([.]0)?\"}[5m])) or sum by (job) (rate(http_server_requests_seconds_bucket{job=\"vocabulary-api\",route!=\"import\",le=~\"2([.]0)?\"}[5m]))"
    },
    {
      "record": "jp_p05:http_slow2s:ratio5m",
      "expr": "1 - (jp_p05:http_fast2s:rate5m / jp_p05:http_duration:rate5m)"
    },
    {
      "record": "jp_p05:jwks_observed:increase10m",
      "expr": "sum by (job) (increase(app_dependency_duration_seconds_count{job=~\"user-api|vocabulary-api\",dependency=\"jwks-api\",operation=\"jwks.fetch\"}[10m]))"
    },
    {
      "record": "jp_p05:jwks_failed:increase10m",
      "expr": "sum by (job) (increase(app_dependency_duration_seconds_count{job=~\"user-api|vocabulary-api\",dependency=\"jwks-api\",operation=\"jwks.fetch\",outcome=~\"failure|timeout\"}[10m]))"
    },
    {
      "record": "jp_p05:jwks_fast2s:increase10m",
      "expr": "sum by (job) (increase(app_dependency_duration_seconds_bucket{job=~\"user-api|vocabulary-api\",dependency=\"jwks-api\",operation=\"jwks.fetch\",le=~\"2([.]0)?\"}[10m]))"
    },
    {
      "record": "jp_p05:jwks_slow2s:ratio10m",
      "expr": "1 - (jp_p05:jwks_fast2s:increase10m / jp_p05:jwks_observed:increase10m)"
    },
    {
      "record": "jp_p05:auth_events:increase5m",
      "expr": "sum by (job) (increase(app_security_events_total{job=~\"user-api|vocabulary-api\",operation=~\"login|refresh|authentication\"}[5m]))"
    },
    {
      "record": "jp_p05:auth_failed:increase5m",
      "expr": "sum by (job) (increase(app_security_events_total{job=~\"user-api|vocabulary-api\",operation=~\"login|refresh|authentication\",outcome=~\"unauthenticated|denied|failure\"}[5m]))"
    },
    {
      "record": "jp_p05:authorization_denied:increase5m",
      "expr": "sum by (job) (increase(app_security_events_total{job=~\"user-api|vocabulary-api\",operation=\"authorization\",outcome=\"denied\"}[5m]))"
