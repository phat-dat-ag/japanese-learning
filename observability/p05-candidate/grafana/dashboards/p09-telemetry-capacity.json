  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Telemetry scrape availability",
      "type": "timeseries",
      "description": "Missing scrape is UNKNOWN. No direct collector/Tempo/OpenSearch scrape exists. Window: current gauge, displayed over selected time range. Gaps/NaN mean unknown; no zero fill.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "jp-dev-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(job)(up{job=~\"prometheus|p07-storage\"})",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN / no series",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Physical backing disk free",
      "type": "timeseries",
      "description": "Physical Windows backing drive measurement supplied by existing monitor. Window: current gauge, displayed over selected time range. Gaps/NaN mean unknown; no zero fill.",
